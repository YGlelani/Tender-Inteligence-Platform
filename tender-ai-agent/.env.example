# =============================================================
# AI Agent — environment template
# Copy to .env and fill in real values if needed
# =============================================================

# Azure AI (LLM backend) — resource endpoint without /openai/v1
AZURE_AI_ENDPOINT=https://<your-resource>.services.ai.azure.com
AZURE_AI_API_KEY=change-me
AZURE_AI_DEPLOYMENT=mistral-small-2503
AZURE_AI_TEMPERATURE=0
# Azure deployment name of the embedding model used for document indexing
EMBED_MODEL=text-embedding-3-small
# Only if the embedding model is deployed on a different Azure resource than the LLM
# AZURE_EMBED_ENDPOINT=https://<other-resource>.openai.azure.com
# AZURE_EMBED_API_KEY=change-me
EMBED_TIMEOUT=8                  # seconds per embedding request
EMBED_BREAKER_SECONDS=60         # after a failure, skip embeddings this long (answers fall back to DB keyword search)
LLM_TIMEOUT=30                   # seconds per chat LLM request

# Login API that issues and verifies sign-in tokens (same Docker network)
LOGIN_API_URL=http://jwt-api:8006

# Existing services this Agent will call as tools
CLIENT_API_URL=http://client-api:8001
AI_SERVICE_URL=http://ai:8002
# Must match AI_SERVICE_API_KEY on the AI service; sent as X-Internal-Key
AI_SERVICE_API_KEY=

# Redis (conversation memory, caches, embeddings, vector search)
# Vector search uses the Redis Query Engine: run redis:8 (or redis/redis-stack-server).
# On redis:7 everything still works, but vector search falls back to brute force.
REDIS_URL=redis://redis:6379/0

# Embeddings
EMBED_BATCH_SIZE=64
EMBED_CACHE_TTL=2592000          # 30 days; embeddings never change for the same text+model

# Semantic cache for LLM answers (exact match + same-meaning match)
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_THRESHOLD=0.95    # cosine similarity needed to reuse an answer
SEMANTIC_CACHE_TTL=86400
SEMANTIC_CACHE_LOOKUP_BUDGET=1.5 # max seconds the cache lookup may add before the LLM runs

# Read-through cache for client-api calls (seconds)
UPSTREAM_CACHE_TTL_DETAIL=600
UPSTREAM_CACHE_TTL_LIST=120
UPSTREAM_CACHE_TTL_404=60

# Semantic tender index: re-sync open tenders every N seconds (0 = only at startup, -1 = off)
TENDER_SYNC_INTERVAL=21600
TENDER_SYNC_MAX=3000

# Onboarding document vault (mount a volume here)
AGENT_DATA_DIR=/data
# Deployment that reads scanned PDFs / photos (defaults to AZURE_AI_DEPLOYMENT;
# mistral-small-2503 supports images)
# AZURE_AI_VISION_DEPLOYMENT=mistral-small-2503

# Agent behaviour
AGENT_MAX_ITERATIONS=4
AGENT_TIMEOUT_SECONDS=45

# CORS
CORS_ORIGINS=*

# API key (optional — protect the chat endpoint)
# AGENT_API_KEY=change-me