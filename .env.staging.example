# =============================================================================
# Staging settings for compose.staging.yaml
#
#   cp .env.staging.example .env.staging      (.env.staging is git-ignored)
#   docker compose --env-file .env.staging -f compose.staging.yaml up -d --build
#
# Rules
# - Every secret here is NEW and used only by staging. Never copy a production value.
#   Generate each one with:  openssl rand -hex 32
#   (hex keeps them safe inside URLs and .env files)
# - Only STAGING_* names and USER_SERVER_IP are read. The service addresses one
#   container uses to reach another are fixed in compose.staging.yaml, so nothing
#   here can point staging at a production database, Redis or API.
# - Values marked "change-me" must be replaced; check_staging.py refuses them.
# Full reference: ENVIRONMENT_VARIABLES.md
# =============================================================================

# --- Server -----------------------------------------------------------------
# IP address or host name browsers use to reach the staging server.
# On your own machine: localhost
USER_SERVER_IP=change-me

# Tag for the images Compose builds (tender-staging/<service>:<tag>).
STAGING_IMAGE_TAG=staging

# --- Required secrets (staging only) ----------------------------------------
# Signs and verifies sign-in tokens (Login, Signup, Alerts, Notifications APIs).
STAGING_JWT_SECRET=change-me
# Signup and Login APIs -> Notifications API (X-Internal-Key).
STAGING_INTERNAL_API_KEY=change-me
# Signup API -> AI agent, account deletion.
STAGING_ACCOUNT_DELETION_KEY=change-me
# AI agent -> AI service (X-Internal-Key).
STAGING_AI_SERVICE_API_KEY=change-me
# Protects the scraper API's write endpoints.
STAGING_SCRAPER_API_KEY=change-me

# --- AI agent: Azure AI (use a staging key or resource) -------------------------
# Empty = the agent starts, but chat and embeddings report "degraded".
STAGING_AZURE_AI_ENDPOINT=
STAGING_AZURE_AI_API_KEY=
STAGING_AZURE_AI_DEPLOYMENT=mistral-small-2503
STAGING_AZURE_AI_VISION_DEPLOYMENT=
STAGING_EMBED_MODEL=text-embedding-3-small
STAGING_AZURE_EMBED_ENDPOINT=
STAGING_AZURE_EMBED_API_KEY=
# Lets an operator start a full re-index (X-Admin-Key). Empty = switched off.
STAGING_AGENT_ADMIN_KEY=
# Seconds between tender re-indexing runs (0 = only at start-up, -1 = off).
STAGING_TENDER_SYNC_INTERVAL=21600

# --- AI service: Ollama model (pulled once into the staging Ollama volume) ---
# Production uses llama3.1:8b (about 5 GB of memory). On a small or shared server
# llama3.2:3b is lighter.
STAGING_AI_MODEL=llama3.1:8b
STAGING_AI_REQUEST_TIMEOUT_SECONDS=600
STAGING_OLLAMA_KEEP_ALIVE=5m

# --- E-mail (use a sandbox/test SMTP service, never the production mailbox) --
# Empty = sign-up, password reset and notification e-mails fail with a clear error.
# The APIs need STARTTLS (SMTP_USE_TLS=true) or SMTPS (false) with a valid certificate.
STAGING_EMAIL_FROM=
STAGING_SMTP_HOST=
STAGING_SMTP_PORT=587
STAGING_SMTP_USERNAME=
STAGING_SMTP_PASSWORD=
STAGING_SMTP_USE_TLS=true

# --- Links written into e-mails (defaults derive from USER_SERVER_IP) ---------
# Signup verification page; must end in /verify.html.
# STAGING_EMAIL_CONFIRMATION_URL=http://<USER_SERVER_IP>:18008/verify.html
# Login page linked from account e-mails.
# STAGING_LOGIN_PAGE_URL=http://<USER_SERVER_IP>:18009/login.html

# --- Behaviour -----------------------------------------------------------------
STAGING_SESSION_TIMEOUT_HOURS=2
STAGING_ALERT_SCAN_INTERVAL_SECONDS=300
# The scraper fills the empty staging database from the public eTenders site.
STAGING_SCRAPER_LOOP_ENABLED=true
STAGING_ETENDERS_BASE_URL=https://www.etenders.gov.za
# Browser origins allowed by the APIs. Default: the staging main site and AI workspace.
# STAGING_CORS_ORIGINS=http://<USER_SERVER_IP>:18009,http://<USER_SERVER_IP>:19001

# --- Host ports (production uses the same numbers minus 10000) ----------------
STAGING_SCRAPER_PORT=18000
STAGING_CLIENT_PORT=18001
STAGING_CACHE_PORT=18003
STAGING_LOGIN_PORT=18006
STAGING_SIGNUP_PORT=18007
STAGING_FRONTEND_PORT=18009
STAGING_AGENT_PORT=19000
STAGING_AI_FRONTEND_PORT=19001
STAGING_ML_PORT=19004
STAGING_ALERTS_PORT=19005
STAGING_NOTIFICATIONS_PORT=19007
STAGING_SIGNUP_FRONTEND_PORT=18008
